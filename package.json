{
  "name": "brave-bear-events",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "validate": "pnpm lint && pnpm typecheck && node tools/check.mjs && pnpm test && pnpm audit --audit-level=high && node tools/build.mjs",
    "build": "pnpm validate",
    "dev": "node tools/serve.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  }
}
